OPENAI_API_KEY=your-openai-api-key
OPENAI_AGENT_MODEL=gpt-5.5

BRIGHTDATA_API_KEY=your-bright-data-api-key
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# Optional tuning
BRIGHTDATA_REQUEST_ENDPOINT=https://api.brightdata.com/request
BRIGHTDATA_TIMEOUT_SECONDS=60
BRIGHTDATA_COUNTRY=us

# --- Messaging front door (Linq) ---
# Leave blank to run the webhook route without sending real replies.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3

# --- Money in (Stripe) ---
# ONE payment link, priced "customer chooses price". The order id is appended
# as ?client_reference_id=<id>; never mint a link per transaction.
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=

# --- Money out / channel B (pay-per-call enrichment) ---
# Apify works with just a token. Perflo brokers the same catalogue against a
# budget-capped agent mandate, but needs KYC first.
APIFY_TOKEN=
PERFLO_AGENT_TOKEN=
PERFLO_MANDATE_ID=
PERFLO_API_BASE_URL=https://api.perflo.ai

# Hard ceiling on provider spend, in cents, independent of the Perflo mandate.
ENRICHMENT_BUDGET_CENTS=500

# --- Operator auth ---
# Setting ADMIN_PHONE turns ON the passcode gate for every data route. The
# code is texted to this number via Linq, so LINQ_API_KEY must also be set.
# Leaving it blank means the API is OPEN to anyone who can reach the URL, and
# it serves names, LinkedIn URLs, emails and phone numbers. Fine on localhost;
# never on a tunnel or a Superserve preview URL.
ADMIN_PHONE=
ADMIN_SESSION_TTL_HOURS=24

# Public HTTPS base URL for webhook callbacks (ngrok/cloudflared in dev).
PUBLIC_BASE_URL=http://localhost:8000
